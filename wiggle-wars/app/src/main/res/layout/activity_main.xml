<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hamxanadeem.wigglewars.ui.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Everything here is padded clear of the camera cutout (see Screen.padForInsets). -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/soundButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/sound"
                android:src="@drawable/ic_volume_on" />

            <ImageButton
                android:id="@+id/vibrationButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/vibration"
                android:src="@drawable/ic_vibration" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:minHeight="50dp" />

        <!-- Main menu on the right. -->
        <LinearLayout
            android:id="@+id/menuColumn"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/statsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="@color/gold"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cpuButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_play"
                android:text="@string/vs_cpu" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/localButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/pass_and_play" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/onlineButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:background="@drawable/bg_button_revive"
                android:text="@string/play_online"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/armoryButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/armory"
                android:textSize="16sp" />

            <Button
                android:id="@+id/privacyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_settings"
                android:textColor="@color/text_soft"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Match setup: one wide card with everything in view. -->
        <ScrollView
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/setupCard"
                    android:layout_width="660dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/setupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#66000000"
                        android:shadowDy="2"
                        android:shadowRadius="2"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Left: where and with what. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_weight="1.1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SetupLabel"
                                android:text="@string/label_arena" />

                            <com.hamxanadeem.wigglewars.ui.ArenaCardView
                                android:id="@+id/arenaCard"
                                android:layout_width="match_parent"
                                android:layout_height="150dp" />

                            <TextView
                                style="@style/SetupLabel"
                                android:layout_marginTop="10dp"
                                android:text="@string/label_weapons" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/weaponSetButton"
                                style="@style/GameButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_button_secondary"
                                android:lineSpacingMultiplier="0.9"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Right: who's playing. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SetupLabel"
                                android:text="@string/label_teams" />

                            <LinearLayout
                                style="@style/StepRow">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/teamsMinus"
                                    style="@style/StepButton"
                                    android:text="@string/minus" />

                                <TextView
                                    android:id="@+id/teamsText"
                                    style="@style/StepLabel" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/teamsPlus"
                                    style="@style/StepButton"
                                    android:text="@string/plus" />
                            </LinearLayout>

                            <TextView
                                style="@style/SetupLabel"
                                android:layout_marginTop="8dp"
                                android:text="@string/label_worms" />

                            <LinearLayout
                                style="@style/StepRow">

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/wormsMinus"
                                    style="@style/StepButton"
                                    android:text="@string/minus" />

                                <TextView
                                    android:id="@+id/wormsText"
                                    style="@style/StepLabel" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/wormsPlus"
                                    style="@style/StepButton"
                                    android:text="@string/plus" />
                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/difficultyButton"
                                style="@style/GameButton"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_button_secondary"
                                android:textSize="15sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/bananaButton"
                                style="@style/GameButton"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_button_revive"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/backButton"
                            style="@style/GameButton"
                            android:layout_width="120dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="@string/back"
                            android:textSize="17sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/startButton"
                            style="@style/GameButton"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_play"
                            android:text="@string/start" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Armory: browse every weapon. -->
    <FrameLayout
        android:id="@+id/armoryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.hamxanadeem.wigglewars.ui.WeaponPickerView
            android:id="@+id/armoryPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/armory" />
    </FrameLayout>
</FrameLayout>
