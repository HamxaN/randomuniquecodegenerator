<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hamxanadeem.wigglewars.ui.BattleView
        android:id="@+id/battleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/battle_description" />

    <FrameLayout
        android:id="@+id/overlayContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/pauseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_control"
            android:contentDescription="@string/pause"
            android:src="@drawable/ic_pause" />

        <!-- Movement on the left. -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/backflipButton"
                    style="@style/ControlButton"
                    android:contentDescription="@string/backflip"
                    android:text="↶"
                    android:textSize="22sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/jumpButton"
                    style="@style/ControlButton"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/jump"
                    android:text="⤴"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/leftButton"
                    style="@style/ControlButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="@string/walk_left"
                    android:text="◀" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/rightButton"
                    style="@style/ControlButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/walk_right"
                    android:text="▶" />
            </LinearLayout>
        </LinearLayout>

        <!-- Weapons and fire on the right. -->
        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/weaponButton"
                    style="@style/GameButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/skipButton"
                    style="@style/GameButton"
                    android:layout_width="52dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/skip"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fireButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/bg_button_fire"
                android:text="@string/fire"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Weapon picker. -->
        <FrameLayout
            android:id="@+id/weaponPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/choose_weapon"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <GridLayout
                    android:id="@+id/weaponGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />
            </LinearLayout>
        </FrameLayout>

        <!-- Pause. -->
        <FrameLayout
            android:id="@+id/pauseOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/paused"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/resumeButton"
                    style="@style/GameButton"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_button_play"
                    android:text="@string/resume" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/quitButton"
                    style="@style/GameButton"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/quit" />
            </LinearLayout>
        </FrameLayout>

        <!-- Game over. -->
        <FrameLayout
            android:id="@+id/overOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/overCard"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/overTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:shadowColor="#FF000000"
                    android:shadowDy="3"
                    android:shadowRadius="2"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/overStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:textColor="@color/text_soft"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/rematchButton"
                        style="@style/GameButton"
                        android:layout_width="0dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_play"
                        android:text="@string/rematch" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/menuButton"
                        style="@style/GameButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/menu" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
