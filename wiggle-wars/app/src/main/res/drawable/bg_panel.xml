<?xml version="1.0" encoding="utf-8"?>
<!-- Sci-fi glass panel: dark navy, a thin cyan edge and brighter corner brackets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#EB0E1634" android:endColor="#F2070B1C" />
            <stroke android:width="1.5dp" android:color="#8800E5FF" />
        </shape>
    </item>
    <!-- Faint inner line. -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape>
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="#1A00E5FF" />
        </shape>
    </item>
    <!-- Corner brackets. -->
    <item android:gravity="top|start" android:width="26dp" android:height="3dp"><shape><solid android:color="#FF00E5FF" /></shape></item>
    <item android:gravity="top|start" android:width="3dp" android:height="26dp"><shape><solid android:color="#FF00E5FF" /></shape></item>
    <item android:gravity="top|end" android:width="26dp" android:height="3dp"><shape><solid android:color="#FFFF2BD6" /></shape></item>
    <item android:gravity="top|end" android:width="3dp" android:height="26dp"><shape><solid android:color="#FFFF2BD6" /></shape></item>
    <item android:gravity="bottom|start" android:width="26dp" android:height="3dp"><shape><solid android:color="#FFFF2BD6" /></shape></item>
    <item android:gravity="bottom|start" android:width="3dp" android:height="26dp"><shape><solid android:color="#FFFF2BD6" /></shape></item>
    <item android:gravity="bottom|end" android:width="26dp" android:height="3dp"><shape><solid android:color="#FF00E5FF" /></shape></item>
    <item android:gravity="bottom|end" android:width="3dp" android:height="26dp"><shape><solid android:color="#FF00E5FF" /></shape></item>
</layer-list>
