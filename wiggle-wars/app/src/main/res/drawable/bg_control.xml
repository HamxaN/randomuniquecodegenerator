<?xml version="1.0" encoding="utf-8"?>
<!-- Round on-screen control: a glossy navy button with a light rim that brightens when held. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#FF5C7CC4" android:endColor="#FF34508F" />
                    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#66000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#E6324770" android:endColor="#E61A2645" />
                    <stroke android:width="2dp" android:color="#B3FFFFFF" />
                </shape>
            </item>
            <item android:bottom="26dp" android:left="12dp" android:right="12dp" android:top="4dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
