<resources>
    <style name="Theme.WiggleWars" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="GameButton">
        <item name="android:layout_height">64dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ControlButton">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_control</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">26sp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StepButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StepLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
