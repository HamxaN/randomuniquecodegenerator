<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/main"
        app:navigationIcon="@drawable/ic_shield"
        app:navigationIconTint="@color/brand"
        app:navigationContentDescription="@string/app_name"
        app:title="@string/app_name" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intro"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints=""
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/message_hint"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="5"
                android:padding="16dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_soft"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/sender"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints=""
                android:background="@drawable/bg_input"
                android:hint="@string/sender_hint"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_soft"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/paste"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/paste"
                    app:icon="@drawable/ic_paste" />

                <Button
                    android:id="@+id/screenshot"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/screenshot"
                    app:icon="@drawable/ic_image" />
            </LinearLayout>

            <Button
                android:id="@+id/check"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="@string/check"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/verdict_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/verdict_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.92"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <com.hamxanadeem.scamradar.ui.ScoreRing
                        android:id="@+id/ring"
                        android:layout_width="84dp"
                        android:layout_height="84dp" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        android:id="@+id/why_title"
                        style="@style/CardTitle" />

                    <LinearLayout
                        android:id="@+id/reasons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/links_title"
                        style="@style/CardTitle"
                        android:layout_marginTop="12dp"
                        android:text="@string/links_found" />

                    <LinearLayout
                        android:id="@+id/links"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        android:id="@+id/advice_title"
                        style="@style/CardTitle" />

                    <LinearLayout
                        android:id="@+id/advice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <Button
                    android:id="@+id/share_warning"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/share_warning"
                    app:icon="@drawable/ic_share" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/copy"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/copy_warning" />

                    <Button
                        android:id="@+id/clear"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/check_another" />
                </LinearLayout>

                <TextView
                    style="@style/Note"
                    android:text="@string/disclaimer" />
            </LinearLayout>

            <TextView
                android:id="@+id/footer"
                style="@style/Note"
                android:layout_marginTop="20dp"
                android:gravity="center" />

            <TextView
                style="@style/Note"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/privacy" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
