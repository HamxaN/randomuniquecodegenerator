<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <include
            android:id="@+id/month_nav"
            layout="@layout/view_month_nav" />

        <LinearLayout
            android:id="@+id/where_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/where_title" />

            <com.hamxanadeem.spendwise.ui.DonutView
                android:id="@+id/donut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/donut_empty"
                style="@style/Note"
                android:gravity="center"
                android:text="@string/empty_month" />

            <LinearLayout
                android:id="@+id/legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/daily_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/daily_title" />

            <com.hamxanadeem.spendwise.ui.DailyBarsView
                android:id="@+id/daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/daily_note"
                style="@style/Note" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trend_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/trend_title" />

            <com.hamxanadeem.spendwise.ui.TrendView
                android:id="@+id/trend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/Note"
                android:text="@string/trend_legend" />

            <TextView
                android:id="@+id/trend_note"
                style="@style/Note"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subs_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/subs_title" />

            <TextView
                android:id="@+id/subs_note"
                style="@style/Note" />

            <LinearLayout
                android:id="@+id/subscriptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/anomalies_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/anomalies_title" />

            <TextView
                style="@style/Note"
                android:text="@string/anomalies_note" />

            <LinearLayout
                android:id="@+id/anomalies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
