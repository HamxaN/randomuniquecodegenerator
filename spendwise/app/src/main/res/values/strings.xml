    <!-- Welcome -->
    <string name="welcome_title">Welcome to Spendwise</string>
    <string name="welcome_body">Track spending in seconds and let the app do the thinking.\n\n• Type things like “coffee 4.50” or “uber 12 yesterday” and it fills in the rest.\n• It learns your categories from what you pick.\n• Set budgets, see safe-to-spend per day, and get a nudge before you overspend.\n• It spots subscriptions and unusual payments for you.\n\nNo ads, no sign-up, no tracking. Your data stays on this phone and in your phone’s Google backup.</string>
    <string name="welcome_go">Let’s go</string>

