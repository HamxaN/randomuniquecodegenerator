; Engine configuration file.
; Last Drop: an island battle royale with squads, vehicles and online play.

config_version=5

[application]

config/name="Last Drop"
config/description="Drop onto the island, gear up and be the last squad standing."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.07, 0.09, 1)
boot_splash/show_image=false

[autoload]

Save="*res://scripts/save.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighters"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="loot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
