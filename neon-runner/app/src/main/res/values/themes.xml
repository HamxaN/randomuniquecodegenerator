<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NeonRunner" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="android:windowBackground">@color/space</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="GameButton">
        <item name="android:layout_height">60dp</item>
        <item name="android:fontFamily">@font/orbitron_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Overlay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">#B3050214</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">320dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">22dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">@font/orbitron_black</item>
        <item name="android:shadowColor">#FFFF2BD6</item>
        <item name="android:shadowRadius">14</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">26sp</item>
    </style>
</resources>
