<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFF3E0">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFB74D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_home" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/levelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#66000000"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp" />

                <ProgressBar
                    android:id="@+id/tidyBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@drawable/bar_tidy" />
            </LinearLayout>

            <TextView
                android:id="@+id/coinsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textColor="#FFE65100"
                android:textSize="16sp" />
        </LinearLayout>

        <com.hamxanadeem.tidyroom.ui.RoomView
            android:id="@+id/roomView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/room_description" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hintButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_revive"
                android:textSize="17sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp" />
    </LinearLayout>

    <!-- Menu over a peek at the next room. -->
    <FrameLayout
        android:id="@+id/menuPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFF3E0"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/menuContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/soundButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/sound"
                    android:src="@drawable/ic_volume_on" />

                <ImageButton
                    android:id="@+id/vibrationButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/vibration"
                    android:src="@drawable/ic_vibration" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:lineSpacingMultiplier="0.9"
                android:shadowColor="#FFE65100"
                android:shadowDy="5"
                android:shadowRadius="1"
                android:text="@string/title"
                android:textColor="#FFFFB74D"
                android:textSize="54sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tagline"
                android:textColor="#FF8D6E63"
                android:textSize="16sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/menuStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="#FFE65100"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:background="@drawable/bg_button_play"
                android:textSize="24sp" />

            <Button
                android:id="@+id/privacyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_settings"
                android:textColor="#FF8D6E63"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Room tidied. -->
    <FrameLayout
        android:id="@+id/winPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/winCard"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/winTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="#FFE65100"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/winStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFFFB300"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/winText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FF6D4C41"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/doubleButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_revive"
                android:text="@string/double_coins"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:background="@drawable/bg_button_play"
                android:text="@string/next_room" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
