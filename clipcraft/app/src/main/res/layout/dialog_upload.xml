<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/upload_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/upload_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/copyright_checklist"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/check_own"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/check_own" />

    <CheckBox
        android:id="@+id/check_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/check_music" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/copyright_note"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="@string/schedule_switch" />

    <LinearLayout
        android:id="@+id/schedule_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/schedule_when"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/schedule_gap_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/schedule_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/schedule_gap_desc"
            android:stepSize="1"
            android:value="24"
            android:valueFrom="1"
            android:valueTo="72"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_note"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
