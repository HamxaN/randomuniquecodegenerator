<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF7CB342">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: level, cars left, coins. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_home" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/levelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#99000000"
                    android:shadowDy="3"
                    android:shadowRadius="3"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/carsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/coinsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textColor="#FFFFD54F"
                android:textSize="16sp" />
        </LinearLayout>

        <com.hamxanadeem.parkingjam.ui.LotView
            android:id="@+id/lotView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/lot_description" />

        <!-- Bottom bar: restart and hint. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/restartButton"
                style="@style/GameButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/restart"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hintButton"
                style="@style/GameButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_revive"
                android:text="@string/hint"
                android:textSize="17sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp" />
    </LinearLayout>

    <!-- Menu. -->
    <FrameLayout
        android:id="@+id/menuPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF4FC3F7"
        android:clickable="true"
        android:focusable="true">

        <com.hamxanadeem.parkingjam.ui.TitleView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/menuContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/soundButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/sound"
                    android:src="@drawable/ic_volume_on" />

                <ImageButton
                    android:id="@+id/vibrationButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/vibration"
                    android:src="@drawable/ic_vibration" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/menuStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="#FFFFD54F"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:background="@drawable/bg_button_play"
                android:textSize="26sp" />

            <Button
                android:id="@+id/privacyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_settings"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Level cleared. -->
    <FrameLayout
        android:id="@+id/winPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/winCard"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#66000000"
                android:shadowDy="3"
                android:shadowRadius="3"
                android:text="@string/cleared"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/winStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:shadowColor="#99000000"
                android:shadowDy="3"
                android:shadowRadius="3"
                android:textColor="#FFFFD54F"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/winText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/doubleButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_revive"
                android:text="@string/double_coins"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextButton"
                style="@style/GameButton"
                android:layout_width="match_parent"
                android:background="@drawable/bg_button_play"
                android:text="@string/next_level" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
