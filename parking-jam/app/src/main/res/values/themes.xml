<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ParkingJam" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FFFFD54F</item>
        <item name="android:windowBackground">@color/grass</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="GameButton">
        <item name="android:layout_height">64dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
